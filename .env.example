# ------------------------------------------------------------------
# Nourish Studio — environment variables
# Copy to .env for local development. Never commit real secrets.
# On Render, set these in the dashboard (render.yaml covers most).
# ------------------------------------------------------------------

# Required
NODE_ENV=production
PORT=10000

# PostgreSQL connection string (production). When omitted locally, the app
# falls back to a SQLite file (data/app.db).
#
# Supabase (free): Dashboard → Project → Connect → Transaction pooler.
# Use port 6543 and the pooled user, for example:
#   postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres
# SSL is accepted automatically for supabase.co hosts (see lib/db.js).
# Do not commit real connection strings.
DATABASE_URL=

# Initial admin (used only when no user exists yet). Optional if you prefer
# to create the account through the first-run setup screen.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Secret used for sessions and for encrypting stored API secrets (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=836cd42b77b9d8236dc5afecb57fdbc9fc63e260aad9bd7961d9051ea9cc859f
CRON_SECRET=fa452021524660116b34d84fe9e6f75137fcc381bc6a448e
# Optional but recommended for external cron triggering

# Public URL of the deployment. Required for OAuth callbacks and absolute
# image links. Example: https://nourish-studio.onrender.com
APP_URL=https://foods-mate.onrender.com

# ------------------------------------------------------------------
# Gemini (Google AI Studio)
# Free tier: https://aistudio.google.com/apikey
# Image generation requires an image-capable model available to your key.
# ------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# ------------------------------------------------------------------
# Cloudflare Workers AI (free food photography)
# Dashboard → Workers & Pages → Account ID; My Profile → API Tokens →
# create a token with "Account → Workers AI → Read".
# Free plan: 10,000 Neurons/day. flux-1-schnell uses ≈57 per image.
# ------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_VISION_MODEL=@cf/mistralai/mistral-small-3.1-24b-instruct

# ------------------------------------------------------------------
# Google / Blogger OAuth
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web)
# Enable "Blogger API v3". Redirect URI:
#   ${APP_URL}/auth/google/callback
# ------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://foods-mate.onrender.com/auth/google/callback

# ------------------------------------------------------------------
# Pinterest OAuth (API v5)
# https://developers.pinterest.com/apps/
# Redirect URI:
#   ${APP_URL}/auth/pinterest/callback
# Scopes used: boards:read,pins:read,pins:write,user_accounts:read
# ------------------------------------------------------------------
PINTEREST_CLIENT_ID=your-pinterest-app-id
PINTEREST_CLIENT_SECRET=your-pinterest-app-secret
PINTEREST_REDIRECT_URI=https://foods-mate.onrender.com/auth/pinterest/callback

# ------------------------------------------------------------------
# Cloudinary (public image hosting — required for Pinterest publishing)
# ------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ------------------------------------------------------------------
# Nutrition (optional external provider)
# provider: builtin | usda | gemini  (set in the UI, stored in DB)
# USDA key: https://fdc.nal.usda.gov/api-key-signup.html
# ------------------------------------------------------------------
NUTRITION_PROVIDER=builtin
NUTRITION_API_KEY=

# ------------------------------------------------------------------
# Optional runtime tuning
# ------------------------------------------------------------------
# Disable the in-process ticker if you rely only on the Render Cron Job.
ENABLE_INTERNAL_SCHEDULER=true
INTERNAL_SCHEDULER_INTERVAL_SECONDS=60
# Local media directory (Render ephemeral disk; Cloudinary is the durable store)
MEDIA_DIR=
# Local SQLite path when DATABASE_URL is empty
DB_PATH=
